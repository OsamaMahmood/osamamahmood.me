---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/geist-mono/600.css';
import '@fontsource/geist-mono/800.css';
import '../styles/global.css';
import {
  profile, about, experience, skills, projects, contributions,
  research, certs, navWindows,
} from '../data/site';

const banner = ` ██████╗ ███████╗ █████╗ ███╗   ███╗ █████╗
██╔═══██╗██╔════╝██╔══██╗████╗ ████║██╔══██╗
██║   ██║███████╗███████║██╔████╔██║███████║
██║   ██║╚════██║██╔══██║██║╚██╔╝██║██╔══██║
╚██████╔╝███████║██║  ██║██║ ╚═╝ ██║██║  ██║
 ╚═════╝ ╚══════╝╚═╝  ╚═╝╚═╝     ╚═╝╚═╝  ╚═╝`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Osama Mahmood — Cyber Security Lead</title>
    <meta name="description" content={profile.description} />
    <meta name="theme-color" content="#14141f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://osamamahmood.me/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Osama Mahmood — Cyber Security Lead" />
    <meta property="og:description" content={profile.description} />
    <meta property="og:url" content="https://osamamahmood.me/" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="titlebar">
      <div class="titlebar-inner">
        <div class="dots"><div class="dot r"></div><div class="dot y"></div><div class="dot g"></div></div>
        <div class="title-text"><b>{profile.handle}</b> — ~/portfolio — zsh</div>
        <div class="title-spacer"></div>
      </div>
    </div>

    <header class="hero wrap" id="whoami">
      <div class="hero-cmd"><span class="p">❯</span> <span class="c">whoami</span></div>
      <pre class="banner" aria-hidden="true">{banner}</pre>
      <h1 class="banner-sub">M A H M O O D<span class="cursor"></span></h1>
      <p class="hero-lede">
        <strong>Cyber Security Lead at Tabby</strong> — securing the Gulf's first fintech
        unicorn and its <strong>15M+ users</strong>. Breaking things since 2014; building
        <span class="kw">appsec</span>, <span class="kw">cloud security</span> and
        <span class="kw">devsecops</span> programs since 2018.
      </p>
      <div class="social">
        <a class="sbtn gh" href={profile.github} rel="me">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          github
        </a>
        <a class="sbtn li" href={profile.linkedin} rel="me">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
          linkedin
        </a>
        <a class="sbtn em stroke" href={`mailto:${profile.email}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
          email
        </a>
      </div>
    </header>

    <section id="about">
      <div class="wrap sec">
        <div class="sec-label">
          <span class="sec-idx">[01]</span>
          <div class="sec-cmd"><span class="p">❯</span> <span class="c">cat</span> <span class="f">about.md</span></div>
        </div>
        <div>
          <p class="lede">
            I've spent my career on both sides of the wire — <span class="hl">breaking</span> banks
            and fintechs as a consultant and bounty hunter, then <span class="hl">building</span> the
            security programs that stop people like me.
          </p>
          <div class="about-cols">
            {about.cols.map((col) => <p>{col}</p>)}
          </div>
          <div class="figures">
            {about.figures.map((f) => (
              <div class="fig">
                <div class="fig-n">{f.n}{f.sup && <sup>{f.sup}</sup>}</div>
                <div class="fig-l">{f.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="experience">
      <div class="wrap sec">
        <div class="sec-label">
          <span class="sec-idx">[02]</span>
          <div class="sec-cmd"><span class="p">❯</span> <span class="c">git log</span> <span class="f">--career</span></div>
        </div>
        <div class="commits">
          {experience.map((job) => (
            <article class={`commit${job.head ? ' head' : ''}`}>
              <div class="commit-hash">
                <span class="hash">{job.hash}</span>
                {job.refs && <span class="refs"> ({job.head ? <span class="head-ref">{job.refs}</span> : job.refs})</span>}
              </div>
              <h3 class="commit-title">{job.title} <span class="at">@</span> <span class="co">{job.company}</span></h3>
              <div class="commit-meta">{job.meta}</div>
              <p class="commit-body" set:html={job.body} />
              <div class="commit-tags">
                {job.tags.map((t, i) => (
                  <>{i > 0 && <span> · </span>}{t}</>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="skills">
      <div class="wrap sec">
        <div class="sec-label">
          <span class="sec-idx">[03]</span>
          <div class="sec-cmd"><span class="p">❯</span> <span class="c">tree</span> <span class="f">~/skills</span></div>
        </div>
        <div class="tree">
          <div class="tree-row"><span class="tree-root">skills/</span></div>
          {skills.map((s, i) => (
            <div class="tree-row">
              <span class="br">{i === skills.length - 1 ? '└── ' : '├── '}</span>
              <span class="dir">{s.dir}</span>
              <span class="items">{s.items}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="oss">
      <div class="wrap sec">
        <div class="sec-label">
          <span class="sec-idx">[04]</span>
          <div class="sec-cmd"><span class="p">❯</span> <span class="c">ls</span> <span class="f">~/projects</span></div>
        </div>
        <div>
          {projects.map((p, i) => (
            <a class="proj" href={p.url}>
              <span class="proj-i">/{String(i + 1).padStart(2, '0')}</span>
              <span>
                <span class="proj-name">{p.name}</span>
                <span class="proj-desc">{p.desc}</span>
              </span>
              <span class="proj-meta">
                <span class={`lang l-${p.lang}`}>{p.lang}</span>
                {p.stars && <><br /><span class="stars">★ {p.stars}</span></>}
              </span>
            </a>
          ))}

          <div class="contrib-head">upstream contributions</div>
          {contributions.map((p, i) => (
            <a class="proj" href={p.url}>
              <span class="proj-i">/{String(projects.length + i + 1).padStart(2, '0')}</span>
              <span>
                <span class="proj-name">{p.name}{p.badge && <span class="pr-badge">{p.badge}</span>}</span>
                <span class="proj-desc">{p.desc}</span>
              </span>
              <span class="proj-meta">
                <span class={`lang l-${p.lang}`}>{p.lang}</span>
                {p.meta && <><br /><span class="stars">{p.meta}</span></>}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="research">
      <div class="wrap sec">
        <div class="sec-label">
          <span class="sec-idx">[05]</span>
          <div class="sec-cmd"><span class="p">❯</span> <span class="c">tail -f</span> <span class="f">research.log</span></div>
        </div>
        <div>
          {research.map((note) => (
            <article class="note">
              <div class="note-tag"><span class="brk">[</span><span class={`lvl-${note.level}`}>{note.tag}</span><span class="brk">]</span></div>
              <h3>{note.title}{note.badge && <span class="badge">{note.badge}</span>}</h3>
              <p set:html={note.body} />
              {note.chips && (
                <div class="programs">
                  {note.chips.map((chip) => (
                    <span class={`program${chip.startsWith('+') ? ' more' : ''}`}>{chip}</span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="certs">
      <div class="wrap sec">
        <div class="sec-label">
          <span class="sec-idx">[06]</span>
          <div class="sec-cmd"><span class="p">❯</span> <span class="c">ls</span> <span class="f">~/certs</span></div>
        </div>
        <div class="creds">
          {certs.map((c) => (
            <div class={`cred${c.featured ? ' featured' : ''}`}>
              <span class="cred-abbr">{c.abbr}</span>
              <span class="cred-name">{c.name}</span>
              <span class="cred-dots"></span>
              <span class="cred-year">{c.year}</span>
              {c.url && <a class="cred-verify" href={c.url}>[verify]</a>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="writing">
      <div class="wrap sec">
        <div class="sec-label">
          <span class="sec-idx">[07]</span>
          <div class="sec-cmd"><span class="p">❯</span> <span class="c">ls</span> <span class="f">~/writing</span></div>
        </div>
        <div class="writing-empty">
          total 0 <br />
          <span class="cm"># nothing here yet — security write-ups and notes coming soon.</span>
        </div>
      </div>
    </section>

    <footer class="outro" id="contact">
      <div class="wrap">
        <div class="outro-cmd"><span class="p">❯</span> <span class="c">ping</span> osama</div>
        <h2>Working on something that needs to be <span class="hl">secure by design</span>?</h2>
        <a class="outro-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </footer>

    <nav class="status" aria-label="Section navigation">
      <div class="status-session">osama.sh</div>
      <div class="status-wins">
        {navWindows.map((w) => (
          <a href={w.href}><b>{w.n}:</b>{w.label}</a>
        ))}
      </div>
      <div class="status-right">
        <span>no trackers</span><span class="sep">│</span><span>100% static</span><span class="sep">│</span><span>dxb · utc+4</span>
      </div>
    </nav>
  </body>
</html>
